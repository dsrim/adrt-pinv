+static PyObject *adrt_py_gram_freq(PyObject* /* self */, PyObject *const *args, Py_ssize_t nargs) {
+    // Process function arguments: (rows, omega)
+    const std::optional<std::span<PyObject *const, 2>> unpacked_args = adrt::_py::unpack_fastcall<2>(args, nargs, "gram_freq");
+    if(!unpacked_args) {
+        return nullptr;
+    }
+    PyArrayObject *const in_arr = adrt::_py::extract_array(adrt::_common::get<0>(*unpacked_args));
+    PyArrayObject *const om_arr = adrt::_py::extract_array(adrt::_common::get<1>(*unpacked_args));
+    if(!in_arr || !om_arr) {
+        return nullptr;
+    }
+    const std::optional<std::array<size_t, 3>> input_shape = adrt::_py::array_shape<2, 3>(in_arr);
+    if(!input_shape) {
+        return nullptr;
+    }
+    if(!adrt::gram_freq_is_valid_shape(*input_shape)) {
+        PyErr_SetString(PyExc_ValueError, "array must have shape (..., rows, N) with N a power of two");
+        return nullptr;
+    }
+    const std::optional<std::array<size_t, 1>> om_shape = adrt::_py::array_shape<1, 1>(om_arr);
+    if(!om_shape) {
+        return nullptr;
+    }
+    if(adrt::_common::get<0>(*om_shape) != adrt::_common::get<1>(*input_shape)) {
+        PyErr_SetString(PyExc_ValueError, "omega must have one entry per row");
+        return nullptr;
+    }
+    const int ndim = PyArray_NDIM(in_arr);
+    switch(PyArray_TYPE(in_arr)) {
+    case NPY_COMPLEX64:
+    {
+        if(PyArray_TYPE(om_arr) != NPY_FLOAT32) {
+            PyErr_SetString(PyExc_TypeError, "omega must be float32 for complex64 rows");
+            return nullptr;
+        }
+        PyArrayObject *const ret = adrt::_py::new_array(ndim, std::span{*input_shape}, NPY_COMPLEX64);
+        if(!ret) {
+            return nullptr;
+        }
+        const std::complex<float> *const in_data = static_cast<std::complex<float>*>(PyArray_DATA(in_arr));
+        const float *const om_data = static_cast<float*>(PyArray_DATA(om_arr));
+        std::complex<float> *const out_data = static_cast<std::complex<float>*>(PyArray_DATA(ret));
+        // NO PYTHON API BELOW THIS POINT
+        Py_BEGIN_ALLOW_THREADS
+        adrt::gram_freq(in_data, *input_shape, om_data, out_data);
+        // PYTHON API ALLOWED BELOW THIS POINT
+        Py_END_ALLOW_THREADS
+        return adrt::_py::array_to_pyobject(ret);
+    }
+    case NPY_COMPLEX128:
+    {
+        if(PyArray_TYPE(om_arr) != NPY_FLOAT64) {
+            PyErr_SetString(PyExc_TypeError, "omega must be float64 for complex128 rows");
+            return nullptr;
+        }
+        PyArrayObject *const ret = adrt::_py::new_array(ndim, std::span{*input_shape}, NPY_COMPLEX128);
+        if(!ret) {
+            return nullptr;
+        }
+        const std::complex<double> *const in_data = static_cast<std::complex<double>*>(PyArray_DATA(in_arr));
+        const double *const om_data = static_cast<double*>(PyArray_DATA(om_arr));
+        std::complex<double> *const out_data = static_cast<std::complex<double>*>(PyArray_DATA(ret));
+        // NO PYTHON API BELOW THIS POINT
+        Py_BEGIN_ALLOW_THREADS
+        adrt::gram_freq(in_data, *input_shape, om_data, out_data);
+        // PYTHON API ALLOWED BELOW THIS POINT
+        Py_END_ALLOW_THREADS
+        return adrt::_py::array_to_pyobject(ret);
+    }
+    default:
+        adrt::_py::report_unsupported_dtype(in_arr);
+        return nullptr;
+    }
+}
