+#ifndef ADRT_CDEFS_GRAM_H
+#define ADRT_CDEFS_GRAM_H
+
+#include <array>
+#include <span>
+#include <complex>
+#include <vector>
+#include <cstring>
+#include <bit>
+#include <cmath>
+#include <cassert>
+#include "adrt_cdefs_common.hpp"
+
+// Offset-Fourier form of the single-quadrant ADRT and its Gram matrix.
+//
+// After a DFT in the offset, the cyclic single-quadrant ADRT of an N-by-N strip
+// (N = 2^n) is block diagonal: at offset frequency omega it is an N-by-N matrix
+// A_omega = B_n ... B_1, a product of n butterfly levels.  Level m pairs the
+// sections 2l, 2l+1 of width 2^(m-1) at each slope t into slopes 2t, 2t+1 with
+// the 2x2 block [[1, z^t], [1, z^(t+1)]], z = exp(i omega).  This file applies
+// the Gram matrix A_omega^* A_omega to one row (a length-N column vector) per
+// frequency, independently over rows; this is the core of the normal operator
+// R^T R evaluated row by row in cache.
+
+namespace adrt {
+
+    inline bool gram_freq_is_valid_shape(std::span<const size_t, 3> shape) {
+        // shape = (batch, rows, N); N must be a power of two
+        return std::has_single_bit(adrt::_common::get<2>(shape)) && adrt::_common::get<0>(shape) > 0u && adrt::_common::get<1>(shape) > 0u;
+    }
+
+    namespace _impl {
+
+    // in -> out through levels 1..n (forward); buffers swap each level, returns the buffer holding the result
+    template <typename real>
+    std::complex<real> *gram_row_forward(int n, const std::complex<real> *const ADRT_RESTRICT pw, std::complex<real> z,
+                                         std::complex<real> *a, std::complex<real> *b) {
+        const size_t N = 1_uz << n;
+        std::complex<real> *in = a, *out = b;
+        for(int m = 1; m <= n; ++m) {
+            const size_t w = 1_uz << (m - 1), ns = N / (2_uz * w);
+            for(size_t l = 0; l < ns; ++l) {
+                const std::complex<real> *const f0 = in + l * 2_uz * w;
+                const std::complex<real> *const f1 = f0 + w;
+                std::complex<real> *const o = out + l * 2_uz * w;
+                for(size_t t = 0; t < w; ++t) {
+                    const std::complex<real> u = pw[t] * f1[t];
+                    o[2_uz * t] = f0[t] + u;
+                    o[2_uz * t + 1_uz] = f0[t] + u * z;
+                }
+            }
+            std::swap(in, out);
+        }
+        return in;
+    }
+
+    // adjoint: levels n..1
+    template <typename real>
+    std::complex<real> *gram_row_adjoint(int n, const std::complex<real> *const ADRT_RESTRICT pw, std::complex<real> z,
+                                         std::complex<real> *a, std::complex<real> *b) {
+        const size_t N = 1_uz << n;
+        const std::complex<real> zc = std::conj(z);
+        std::complex<real> *in = a, *out = b;
+        for(int m = n; m >= 1; --m) {
+            const size_t w = 1_uz << (m - 1), ns = N / (2_uz * w);
+            for(size_t l = 0; l < ns; ++l) {
+                const std::complex<real> *const g = in + l * 2_uz * w;
+                std::complex<real> *const o0 = out + l * 2_uz * w;
+                std::complex<real> *const o1 = o0 + w;
+                for(size_t t = 0; t < w; ++t) {
+                    const std::complex<real> g0 = g[2_uz * t], g1 = g[2_uz * t + 1_uz];
+                    o0[t] = g0 + g1;
+                    o1[t] = std::conj(pw[t]) * (g0 + zc * g1);
+                }
+            }
+            std::swap(in, out);
+        }
+        return in;
+    }
+
+    } // end namespace adrt::_impl
+
+    // DOC ANCHOR: adrt.core.gram +2
+    // data, out: (batch, rows, N) complex, C order; omega: (rows,) real offset frequencies.
+    template <typename real>
+    void gram_freq(const std::complex<real> *const ADRT_RESTRICT data, std::span<const size_t, 3> shape,
+                   const real *const ADRT_RESTRICT omega, std::complex<real> *const ADRT_RESTRICT out) {
+        assert(data);
+        assert(omega);
+        assert(out);
+        assert(adrt::gram_freq_is_valid_shape(shape));
+        const size_t n_batch = adrt::_common::get<0>(shape), n_rows = adrt::_common::get<1>(shape), N = adrt::_common::get<2>(shape);
+        const int n = std::countr_zero(N);
+
+        ADRT_OPENMP("omp parallel default(none) shared(data, omega, out, n_batch, n_rows, N, n)")
+        {
+            std::vector<std::complex<real>> pw(N / 2_uz + 1_uz), buf_a(N), buf_b(N);
+            ADRT_OPENMP("omp for collapse(2) schedule(static)")
+            for(size_t batch = 0; batch < n_batch; ++batch) {
+                for(size_t row = 0; row < n_rows; ++row) {
+                    const std::complex<real> z = std::polar(static_cast<real>(1), omega[row]);
+                    pw[0] = std::complex<real>(1, 0);
+                    for(size_t t = 1; t < pw.size(); ++t) {
+                        pw[t] = pw[t - 1_uz] * z;
+                    }
+                    const size_t offset = (batch * n_rows + row) * N;
+                    std::memcpy(buf_a.data(), data + offset, N * sizeof(std::complex<real>));
+                    std::complex<real> *const fwd = adrt::_impl::gram_row_forward(n, pw.data(), z, buf_a.data(), buf_b.data());
+                    std::complex<real> *const other = (fwd == buf_a.data()) ? buf_b.data() : buf_a.data();
+                    const std::complex<real> *const res = adrt::_impl::gram_row_adjoint(n, pw.data(), z, fwd, other);
+                    std::memcpy(out + offset, res, N * sizeof(std::complex<real>));
+                }
+            }
+        }
+    }
+
+}
+
+#endif // ADRT_CDEFS_GRAM_H
