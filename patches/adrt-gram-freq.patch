+def _quadrant_strip(x: npt.NDArray[_F], q: int, n: int, /) -> npt.NDArray[_F]:
+    # Torus image (..., 2n, 2n) -> strip (..., 2n, n) of quadrant q in the orientation of the base butterfly
+    r = (n - 1 - np.arange(2 * n)) % (2 * n)
+    if q == 0:
+        return np.swapaxes(x, -1, -2)[..., r, :n]
+    if q == 1:
+        return x[..., r, :n]
+    if q == 2:
+        return x[..., :, :n]
+    return np.swapaxes(x[..., r, :][..., :, r], -1, -2)[..., :n]
+
+
+def _quadrant_strip_adjoint(s: npt.NDArray[_F], q: int, n: int, /) -> npt.NDArray[_F]:
+    # Adjoint of _quadrant_strip: strip (..., 2n, n) -> torus image (..., 2n, 2n)
+    r = (n - 1 - np.arange(2 * n)) % (2 * n)
+    x = np.zeros(s.shape[:-1] + (2 * n,), dtype=s.dtype)
+    x[..., :n] = s
+    if q == 0:
+        return np.swapaxes(x[..., r, :], -1, -2)
+    if q == 1:
+        return x[..., r, :]
+    if q == 2:
+        return x
+    y = np.swapaxes(x, -1, -2)
+    return y[..., :, r][..., r, :]
+
+
+def gram(a: npt.NDArray[_F], /) -> npt.NDArray[_F]:
+    r"""Apply the normal operator of the ADRT, computed row by row in frequency.
+
+    Computes :math:`R^T R a` for square images `a`, where :math:`R` is
+    the ADRT of :func:`adrt.adrt`. The result equals
+    :pycode:`adrt.utils.truncate(adrt.bdrt(adrt.adrt(a))).sum(axis=-3)`
+    but is evaluated differently: after a discrete Fourier transform
+    in the offset, each quadrant of the ADRT becomes block diagonal,
+    one :math:`N \times N` butterfly matrix :math:`A_\omega` per
+    offset frequency, and :math:`R^T R` is applied as
+    :math:`A_\omega^* A_\omega` one frequency row at a time. Each row
+    is processed in cache, which is faster than the transform pair for
+    large `N`, and rows are distributed over threads when
+    :func:`threading_enabled` is :pycode:`True`. Two real quadrants are
+    processed together as the real and imaginary parts of one complex
+    array.
+
+    Parameters
+    ----------
+    a : numpy.ndarray of float
+        The images to which the normal operator is applied. Must have
+        square shape :pycode:`(..., N, N)` with `N` a power of two.
+
+    Returns
+    -------
+    numpy.ndarray of float
+        :math:`R^T R a`, with the same shape and dtype as `a`.
+    """
+    a = np.asarray(a)
+    if a.ndim < 2 or a.shape[-1] != a.shape[-2]:
+        raise ValueError(f"array must be square, but had shape {a.shape}")
+    n = a.shape[-1]
+    if n < 1 or n & (n - 1):
+        raise ValueError(f"array size must be a power of two, but was {n}")
+    if a.dtype == np.float32:
+        cdt, rdt = np.complex64, np.float32
+    elif a.dtype == np.float64:
+        cdt, rdt = np.complex128, np.float64
+    else:
+        raise TypeError(f"unsupported array dtype {a.dtype}")
+    batch = a.shape[:-2]
+    x = np.zeros(batch + (2 * n, 2 * n), dtype=a.dtype)
+    x[..., :n, :n] = a
+    packed = np.stack(
+        [
+            _quadrant_strip(x, 0, n) + 1j * _quadrant_strip(x, 1, n),
+            _quadrant_strip(x, 2, n) + 1j * _quadrant_strip(x, 3, n),
+        ],
+        axis=-3,
+    )
+    f = np.fft.fft(packed, axis=-2).astype(cdt, copy=False)
+    omega = (2 * np.pi * np.fft.fftfreq(2 * n)).astype(rdt)
+    g = _gram_freq(np.ascontiguousarray(f.reshape(-1, 2 * n, n)), omega)
+    w = np.fft.ifft(g.reshape(f.shape), axis=-2)
+    out = (
+        _quadrant_strip_adjoint(w[..., 0, :, :].real, 0, n)
+        + _quadrant_strip_adjoint(w[..., 0, :, :].imag, 1, n)
+        + _quadrant_strip_adjoint(w[..., 1, :, :].real, 2, n)
+        + _quadrant_strip_adjoint(w[..., 1, :, :].imag, 3, n)
+    )
+    return np.ascontiguousarray(out[..., :n, :n], dtype=a.dtype)
+
+
+def lstsq_cheb(
+    b: npt.NDArray[_F],
+    /,
+    *,
+    lam_min: float,
+    lam_max: float | None = None,
+    tol: float = 1e-10,
+    degree: typing.SupportsIndex | None = None,
+) -> npt.NDArray[_F]:
+    r"""Least-squares inverse of the ADRT by a fixed-degree Chebyshev polynomial.
+
+    Returns :math:`x_D = c_D(R^T R)\, R^T b`, the Chebyshev
+    semi-iteration of degree `D` for the normal equations
+    :math:`R^T R x = R^T b` on the spectral interval
+    :math:`[\lambda_{\min}, \lambda_{\max}]`. With a valid interval,
+    :math:`\|x_D - x_{\mathrm{LS}}\| \le 2 \rho^D \|x_{\mathrm{LS}}\|`,
+    :math:`\rho = (\sqrt\kappa - 1)/(\sqrt\kappa + 1)`, where
+    :math:`x_{\mathrm{LS}}` is the least-squares solution. The degree
+    is fixed in advance from the interval and `tol`; no residual is
+    tested. The normal operator is applied by :func:`gram`.
+
+    Parameters
+    ----------
+    b : numpy.ndarray of float
+        Data with the shape of an ADRT output, :pycode:`(..., 4, 2*N-1, N)`.
+    lam_min : float
+        A *lower bound* for the smallest eigenvalue of :math:`R^T R`.
+        Measured values are 15.5, 24.5, 35.7, 50.3, 68.0, 88.7 for
+        `N` = 8 to 256. An overestimate degrades the accuracy; an
+        underestimate only increases the degree.
+    lam_max : float, optional
+        An upper bound for the largest eigenvalue. If omitted it is
+        estimated by power iteration and enlarged by its residual norm.
+    tol : float, optional
+        Relative accuracy of the polynomial (default :pycode:`1e-10`).
+    degree : int, optional
+        Overrides the degree computed from the interval and `tol`.
+
+    Returns
+    -------
+    numpy.ndarray of float
+        The approximate least-squares solution, shape :pycode:`(..., N, N)`.
+    """
+    b = np.asarray(b)
+    if b.ndim < 3 or b.shape[-3] != 4 or b.shape[-2] != 2 * b.shape[-1] - 1:
+        raise ValueError(f"array must have the shape of an ADRT output, but had shape {b.shape}")
+    y = _truncate(_bdrt(np.ascontiguousarray(b))).sum(axis=-3)
+    if lam_max is None:
+        v = np.random.default_rng(0).standard_normal(y.shape[-2:]).astype(y.dtype)
+        v /= np.linalg.norm(v)
+        for _ in range(50):
+            w = gram(v)
+            v = w / np.linalg.norm(w)
+        w = gram(v)
+        theta = float(np.vdot(v, w))
+        lam_max = theta + float(np.linalg.norm(w - theta * v))
+    lo, hi = float(lam_min), float(lam_max)
+    if not 0 < lo < hi:
+        raise ValueError("need 0 < lam_min < lam_max")
+    kappa = hi / lo
+    if degree is None:
+        rho = (np.sqrt(kappa) - 1) / (np.sqrt(kappa) + 1)
+        deg = max(1, int(np.ceil(np.log(tol / 2) / np.log(rho))))
+    else:
+        deg = operator.index(degree)
+    c, a = (hi - lo) / (hi + lo), 2.0 / (hi + lo)
+    x_prev, x = np.zeros_like(y), a * y
+    om = 1.0
+    for k in range(1, deg):
+        om = 1.0 / (1.0 - c * c / 2.0) if k == 1 else 1.0 / (1.0 - c * c * om / 4.0)
+        r = y - gram(x)
+        x_prev, x = x, x + om * (a * r) + (om - 1.0) * (x - x_prev)
+    return x
