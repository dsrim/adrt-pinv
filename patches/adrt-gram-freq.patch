+import pytest
+import numpy as np
+import adrt
+
+
+def _normal_bdrt(a):
+    return adrt.utils.truncate(adrt.bdrt(adrt.adrt(a))).sum(axis=-3)
+
+
+@pytest.mark.parametrize("n", [1, 2, 4, 8, 16, 32, 64])
+def test_matches_bdrt_float64(n):
+    a = np.random.default_rng(n).standard_normal((n, n))
+    ref = _normal_bdrt(a)
+    out = adrt.core.gram(a)
+    assert out.shape == a.shape
+    assert out.dtype == np.float64
+    assert np.allclose(out, ref, rtol=0, atol=1e-11 * np.abs(ref).max())
+
+
+@pytest.mark.parametrize("n", [4, 16, 32])
+def test_matches_bdrt_float32(n):
+    a = np.random.default_rng(n).standard_normal((n, n)).astype(np.float32)
+    ref = _normal_bdrt(a.astype(np.float64))
+    out = adrt.core.gram(a)
+    assert out.dtype == np.float32
+    assert np.allclose(out, ref, rtol=0, atol=2e-5 * np.abs(ref).max())
+
+
+def test_batch():
+    a = np.random.default_rng(0).standard_normal((3, 2, 16, 16))
+    out = adrt.core.gram(a)
+    for i in range(3):
+        for j in range(2):
+            assert np.allclose(out[i, j], _normal_bdrt(a[i, j]), rtol=0, atol=1e-10 * np.abs(out).max())
+
+
+def test_symmetric_positive():
+    rng = np.random.default_rng(1)
+    u, v = rng.standard_normal((2, 16, 16))
+    assert np.isclose(np.vdot(adrt.core.gram(u), v), np.vdot(u, adrt.core.gram(v)))
+    assert np.vdot(adrt.core.gram(u), u) > 0
+
+
+@pytest.mark.parametrize("shape", [(4, 8), (6, 6), (8,)])
+def test_rejects_bad_shape(shape):
+    with pytest.raises(ValueError):
+        adrt.core.gram(np.zeros(shape))
+
+
+def test_rejects_int():
+    with pytest.raises(TypeError):
+        adrt.core.gram(np.zeros((8, 8), dtype=np.int64))
