+
+import pytest
+import numpy as np
+import adrt
+
+
+def _dense_adrt(n):
+    cols = []
+    for j in range(n * n):
+        e = np.zeros(n * n)
+        e[j] = 1
+        cols.append(adrt.adrt(e.reshape(n, n)).ravel())
+    return np.array(cols).T
+
+
+@pytest.mark.parametrize("n", [4, 8, 16])
+def test_matches_lstsq(n):
+    rng = np.random.default_rng(n)
+    mat = _dense_adrt(n)
+    eig = np.linalg.eigvalsh(mat.T @ mat)
+    b = adrt.adrt(rng.standard_normal((n, n))) + 0.1 * rng.standard_normal((4, 2 * n - 1, n))
+    ref = np.linalg.lstsq(mat, b.ravel(), rcond=None)[0].reshape(n, n)
+    out = adrt.core.lstsq_cheb(b, lam_min=0.99 * eig[0], lam_max=1.01 * eig[-1], tol=1e-10)
+    assert np.linalg.norm(out - ref) <= 1e-8 * np.linalg.norm(ref)
+
+
+def test_estimated_lam_max():
+    n = 8
+    rng = np.random.default_rng(3)
+    x = rng.standard_normal((n, n))
+    out = adrt.core.lstsq_cheb(adrt.adrt(x), lam_min=15.0)
+    assert np.linalg.norm(out - x) <= 1e-8 * np.linalg.norm(x)
+
+
+def test_rejects_bad_interval():
+    with pytest.raises(ValueError):
+        adrt.core.lstsq_cheb(adrt.adrt(np.zeros((8, 8))), lam_min=10.0, lam_max=5.0)
